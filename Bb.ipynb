from pathlib import Path
import json, re

def load_json_lenient(path: str):
    s = Path(path).read_text(encoding="utf-8-sig")
    # Replace smart quotes with straight quotes
    s = s.replace("“","\"").replace("”","\"").replace("’","'")
    # If it uses single quotes for JSON-ish text, try converting (unsafe for all cases, but handy)
    if '"' not in s and "'" in s:
        s = re.sub(r"'", '"', s)
    # Replace JS/py literals with JSON ones
    s = re.sub(r"\bTrue\b", "true", s)
    s = re.sub(r"\bFalse\b", "false", s)
    s = re.sub(r"\bNone\b", "null", s)
    # Strip % and $ inside numbers -> keep numeric; else leave text alone
    s = re.sub(r'(?<=[:\[,]\s*)"?(\\$)?([0-9][0-9,]*\\.?[0-9]*)%?"?(?=\s*[,\}])',
               lambda m: m.group(2).replace(",", ""), s)
    # Remove trailing commas: ", ]" or ", }"
    s = re.sub(r",\s*(\]|})", r"\\1", s)
    return json.loads(s)

def save_pretty(obj, path: str):
    Path(path).write_text(json.dumps(obj, indent=2), encoding="utf-8")

