# --- helpers for your vertices/normalized_vertices format ---

def verts_to_pixels(verts, page_w, page_h, normalized=False):
    if not verts:
        return None
    if normalized:
        return [(v["x"] * page_w, v["y"] * page_h) for v in verts]
    return [(v["x"], v["y"]) for v in verts]

def poly_to_rect(poly):
    xs = [p[0] for p in poly]; ys = [p[1] for p in poly]
    x0, x1 = min(xs), max(xs); y0, y1 = min(ys), max(ys)
    return x0, y0, x1 - x0, y1 - y0

def draw_poly(ax, poly, edge, fill_alpha=0.15, lw=1.2, face=None, dashed=False):
    from matplotlib.patches import Polygon, Rectangle
    # polygon fill/outline
    ax.add_patch(Polygon(poly, closed=True,
                         edgecolor=edge, facecolor=face or edge,
                         linewidth=lw, alpha=fill_alpha,
                         linestyle="--" if dashed else "-"))
    # overlay a tight rect as well (nice for quick visual scanning)
    x, y, w, h = poly_to_rect(poly)
    ax.add_patch(Rectangle((x, y), w, h,
                           fill=False, edgecolor=edge, linewidth=lw))

def draw_from_bounding_poly(ax, bp, page_w, page_h, color, dashed=False, header=False):
    # prefer absolute pixels; if absent, use normalized
    verts = bp.get("vertices")
    nverts = bp.get("normalized_vertices")
    if verts:
        poly = verts_to_pixels(verts, page_w, page_h, normalized=False)
    elif nverts:
        poly = verts_to_pixels(nverts, page_w, page_h, normalized=True)
    else:
        return
    draw_poly(ax, poly, edge=color, fill_alpha=0.15 if not header else 0.08,
              lw=1.2 if not header else 1.5, face=color if not header else None, dashed=dashed)

def draw_field_by_schema(ax, field_obj, page_idx, page_w, page_h, color=None):
    # supports either single bounding_poly or spans[]
    spans = field_obj.get("spans")
    if spans:
        for bp in spans:
            if int(bp.get("page", -1)) == page_idx + 1:
                draw_from_bounding_poly(ax, bp, page_w, page_h, color=color or None)
    else:
        bp = field_obj.get("bounding_poly")
        if bp and int(bp.get("page", -1)) == page_idx + 1:
            draw_from_bounding_poly(ax, bp, page_w, page_h, color=color or None)

def draw_table_by_schema(ax, table_obj, page_idx, page_w, page_h, table_color=(0.0,0.7,0.5)):
    if int(table_obj.get("page", -1)) != page_idx + 1:
        return
    # table bbox polygon
    bp = table_obj.get("bbox_poly")
    if bp:
        draw_from_bounding_poly(ax, bp, page_w, page_h, color=table_color)
    # cells
    for cell in table_obj.get("cells", []):
        span = cell.get("span")
        if span and int(span.get("page", -1)) == page_idx + 1:
            draw_from_bounding_poly(ax, span, page_w, page_h,
                                    color=table_color, dashed=bool(cell.get("header", False)),
                                    header=bool(cell.get("header", False)))