{
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "equipment_table_extraction",
      "schema": {
        "type": "object",
        "properties": {
          "Equipment_Table": {
            "type": "array",
            "description": "List of all equipment items with serial, model, and bounding boxes.",
            "items": {
              "type": "object",
              "properties": {
                "Model_Number": {
                  "type": "string",
                  "description": "Model number of the equipment"
                },
                "Serial_Number": {
                  "type": "string",
                  "description": "Serial number of the equipment"
                },
                "Asset_Description": {
                  "type": "object",
                  "description": "Manufacturer or description of the equipment, e.g. 'Make/Model'.",
                  "properties": {
                    "value": { "type": "string" },
                    "page": { "type": "integer" },
                    "bounding_poly": {
                      "type": "object",
                      "properties": {
                        "page": { "type": "integer" },
                        "vertices": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "x": { "type": "number" },
                              "y": { "type": "number" }
                            },
                            "required": ["x", "y"]
                          },
                          "minItems": 3,
                          "maxItems": 8
                        },
                        "normalized_vertices": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "x": { "type": "number" },
                              "y": { "type": "number" }
                            },
                            "required": ["x", "y"]
                          },
                          "minItems": 3,
                          "maxItems": 8
                        }
                      },
                      "required": ["page", "vertices"],
                      "description": "Bounding polygon with absolute and normalized coordinates."
                    }
                  },
                  "required": ["value", "page", "bounding_poly"]
                }
              },
              "required": ["Model_Number", "Serial_Number", "Asset_Description"]
            }
          }
        },
        "required": ["Equipment_Table"],
        "additionalProperties": false
      }
    }
  }
}